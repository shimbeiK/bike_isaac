<?xml version="1.0"?>
<robot name="bike_V3_urdf">

  <!-- ============================================================
       Main body
       Root link of the bicycle articulation.
       Isaac Sim import: Base Type = Mobile
       ============================================================ -->
  <link name="main_body">
    <inertial>
      <origin xyz="-0.251337 -0.001123 0.310924" rpy="0 0 0"/>
      <mass value="2.3123167"/>
      <inertia
        ixx="0.06237483005"
        ixy="0"
        ixz="0"
        iyy="0.04698001994"
        iyz="0"
        izz="0.03020791479"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/body.stl"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/body.stl"/>
      </geometry>
    </collision>
  </link>


  <!-- ============================================================
       IMU
       Corresponds to the original MJCF:

       <site name="imu_site"
             pos="-200.0e-3 0 424.357e-3"
             size="0.01"
             rgba="1 0 0 1"/>

       The IMU link is rigidly attached to main_body.
       ============================================================ -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.000001"/>
      <inertia
        ixx="0.000000001"
        ixy="0"
        ixz="0"
        iyy="0.000000001"
        iyz="0"
        izz="0.000000001"/>
    </inertial>
  </link>

  <joint name="imu_fixed" type="fixed">
    <parent link="main_body"/>
    <child link="imu_link"/>

    <!-- Original MJCF imu_site position:
         x = -200.0e-3  = -0.200000 m
         y = 0           =  0.000000 m
         z = 424.357e-3  =  0.424357 m
    -->
    <origin
      xyz="-0.200000 0 0.424357"
      rpy="0 0 0"/>
  </joint>


  <!-- ============================================================
       Rear tire
       ============================================================ -->
  <link name="back_tire">
    <inertial>
      <origin xyz="0 -0.004273 0" rpy="0 0 0"/>
      <mass value="0.923928"/>
      <inertia
        ixx="0.007352292526"
        ixy="0"
        ixz="0"
        iyy="0.01090125389"
        iyz="0"
        izz="0.007352292526"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/back_tire.stl"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/back_tire.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_tire_pitch" type="continuous">
    <parent link="main_body"/>
    <child link="back_tire"/>

    <origin
      xyz="0 0 0.15"
      rpy="0 0 0"/>

    <axis xyz="0 -1 0"/>
  </joint>


  <!-- ============================================================
       Front fork
       ============================================================ -->
  <link name="fork">
    <inertial>
      <origin xyz="0 0 -0.040874" rpy="0 0 0"/>
      <mass value="0.482246"/>
      <inertia
        ixx="0.004616"
        ixy="0"
        ixz="0"
        iyy="0.00451647025"
        iyz="0"
        izz="0.000100681436"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/fork.stl"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/fork.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="fork_yaw" type="revolute">
    <parent link="main_body"/>
    <child link="fork"/>

    <origin
      xyz="-0.492314 0 0.34492"
      rpy="0 0.20847 0"/>

    <axis xyz="0 0 -1"/>

    <limit
      lower="-1.570796"
      upper="1.570796"/>
  </joint>


  <!-- ============================================================
       Front tire
       ============================================================ -->
  <link name="front_tire">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.749780"/>
      <inertia
        ixx="0.005349419022"
        ixy="0"
        ixz="0"
        iyy="0.008289292138"
        iyz="0"
        izz="0.005349419022"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/front_tire.stl"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="/home/shin-linux/bike_isaac/assets/assets/front_tire.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_tire_pitch" type="continuous">
    <parent link="fork"/>
    <child link="front_tire"/>

    <origin
      xyz="0 0 -0.212269"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
  </joint>


</robot>
